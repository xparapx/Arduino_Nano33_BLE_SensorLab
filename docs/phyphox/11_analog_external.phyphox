<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>외장 센서 (아날로그)</title>
    <icon format="string">EXT</icon>
    <color>42eaff</color>
    <category>Nano 33 BLE Sense (외장)</category>
    <description>A0·A1·A2 핀의 전압을 측정합니다. 외장 아날로그 센서를 연결해 사용하세요.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">v0</container>
        <container size="0">v1</container>
        <container size="0">v2</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">00001041</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">v0</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">v1</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">v2</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="아날로그 입력 (A0·A1·A2)" labelX="시간" unitX="s" labelY="전압" unitY="V" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ff5252">v0</input>
            <input axis="x">t</input>
            <input axis="y" color="69f0ae">v1</input>
            <input axis="x">t</input>
            <input axis="y" color="40c4ff">v2</input>
        </graph>
    </view>
    <view label="성분별">
        <graph label="A0" labelX="시간" unitX="s" labelY="전압" unitY="V" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ff5252">v0</input>
        </graph>
        <graph label="A1" labelX="시간" unitX="s" labelY="전압" unitY="V" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="69f0ae">v1</input>
        </graph>
        <graph label="A2" labelX="시간" unitX="s" labelY="전압" unitY="V" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="40c4ff">v2</input>
        </graph>
    </view>
    <view label="측정값">
        <info label="실시간 전압 (A0=빨강, A1=초록, A2=파랑)" bold="true"/>
        <separator height="0.3"/>
        <value label="A0" size="2" precision="3" unit="V" color="ff5252">
            <input>v0</input>
        </value>
        <value label="A1" size="2" precision="3" unit="V" color="69f0ae">
            <input>v1</input>
        </value>
        <value label="A2" size="2" precision="3" unit="V" color="40c4ff">
            <input>v2</input>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="센서 출력을 A0~A2에, GND를 보드 GND에 연결하세요 (0~3.3 V 범위!)."/>
        <info label="물리량 환산(예: 전압→온도)은 펌웨어의 choice 9 수식을 수정하세요."/>
    </view>
    </views>

    <export>
        <set name="아날로그 데이터">
            <data name="t (s)">t</data>
            <data name="A0 (V)">v0</data>
            <data name="A1 (V)">v1</data>
            <data name="A2 (V)">v2</data>
        </set>
    </export>
</phyphox>
