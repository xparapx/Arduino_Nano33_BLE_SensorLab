<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>자이로스코프 (Nano BLE)</title>
    <category>Nano 33 BLE Sense</category>
    <description>BMI270 IMU로 3축 각속도를 측정합니다.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">vx</container>
        <container size="0">vy</container>
        <container size="0">vz</container>
        <container size="0">vm</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">00000040</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">vx</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">vy</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">vz</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">vm</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="자이로스코프 (x·y·z)" labelX="시간" unitX="s" labelY="자이로스코프" unitY="°/s" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ff5252">vx</input>
            <input axis="x">t</input>
            <input axis="y" color="69f0ae">vy</input>
            <input axis="x">t</input>
            <input axis="y" color="40c4ff">vz</input>
        </graph>
        <graph label="크기 |v|" labelX="시간" unitX="s" labelY="|v|" unitY="°/s" partialUpdate="true" style="lines" lineWidth="2">
            <input axis="x">t</input>
            <input axis="y" color="ffd740">vm</input>
        </graph>
    </view>
    <view label="성분별">
        <graph label="x 성분" labelX="시간" unitX="s" labelY="x" unitY="°/s" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ff5252">vx</input>
        </graph>
        <graph label="y 성분" labelX="시간" unitX="s" labelY="y" unitY="°/s" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="69f0ae">vy</input>
        </graph>
        <graph label="z 성분" labelX="시간" unitX="s" labelY="z" unitY="°/s" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="40c4ff">vz</input>
        </graph>
    </view>
    <view label="측정값">
        <info label="실시간 측정값 (x=빨강, y=초록, z=파랑)" bold="true"/>
        <separator height="0.3"/>
        <value label="x" size="2" precision="3" unit="°/s" color="ff5252">
            <input>vx</input>
        </value>
        <value label="y" size="2" precision="3" unit="°/s" color="69f0ae">
            <input>vy</input>
        </value>
        <value label="z" size="2" precision="3" unit="°/s" color="40c4ff">
            <input>vz</input>
        </value>
        <separator height="0.3"/>
        <value label="크기 |v|" size="3" precision="3" unit="°/s" color="ffd740">
            <input>vm</input>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="센서: BMI270, 각속도(회전 속도)"/>
    </view>
    </views>

    <export>
        <set name="자이로스코프 데이터">
            <data name="t (s)">t</data>
            <data name="x (°/s)">vx</data>
            <data name="y (°/s)">vy</data>
            <data name="z (°/s)">vz</data>
            <data name="|v| (°/s)">vm</data>
        </set>
    </export>
</phyphox>
