<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>07 조도</title>
    <icon format="string">LUX</icon>
    <color>42eaff</color>
    <category>Nano 33 BLE Sense</category>
    <description>APDS9960의 Clear 채널로 주변 밝기를 측정합니다.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">amb</container>
        <container size="0">cr</container>
        <container size="0">cg</container>
        <container size="0">cb</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">0000c040</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">amb</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">cr</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">cg</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">cb</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="주변 밝기" labelX="시간" unitX="s" labelY="밝기" unitY="counts" partialUpdate="true" style="lines" lineWidth="2">
            <input axis="x">t</input>
            <input axis="y" color="ffd740">amb</input>
        </graph>
    </view>
    <view label="측정값">
        <value label="밝기" size="3" precision="0" unit="counts" color="ffd740">
            <input>amb</input>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="상대적 밝기(counts)입니다. lux 환산이 필요하면 조도계와 비교 보정하세요."/>
    </view>
    </views>

    <export>
        <set name="조도 데이터">
            <data name="t (s)">t</data>
            <data name="밝기 (counts)">amb</data>
        </set>
    </export>
</phyphox>
