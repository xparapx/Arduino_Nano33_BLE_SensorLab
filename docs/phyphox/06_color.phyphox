<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>09 색상 (RGB)</title>
    <icon format="string">RGB</icon>
    <color>42eaff</color>
    <category>Nano 33 BLE Sense</category>
    <description>APDS9960으로 빛의 R·G·B 성분을 측정합니다. 성분별 차트와 수치를 제공합니다.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">amb</container>
        <container size="0">cr</container>
        <container size="0">cg</container>
        <container size="0">cb</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">0000c040</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">amb</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">cr</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">cg</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">cb</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="RGB 성분" labelX="시간" unitX="s" labelY="세기" unitY="counts" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ff5252">cr</input>
            <input axis="x">t</input>
            <input axis="y" color="66bb6a">cg</input>
            <input axis="x">t</input>
            <input axis="y" color="42a5f5">cb</input>
        </graph>
    </view>
    <view label="성분별">
        <graph label="Red" labelX="시간" unitX="s" labelY="R" unitY="counts" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ff5252">cr</input>
        </graph>
        <graph label="Green" labelX="시간" unitX="s" labelY="G" unitY="counts" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="66bb6a">cg</input>
        </graph>
        <graph label="Blue" labelX="시간" unitX="s" labelY="B" unitY="counts" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="42a5f5">cb</input>
        </graph>
    </view>
    <view label="측정값">
        <info label="실시간 색상 성분" bold="true"/>
        <separator height="0.3"/>
        <value label="Red" size="2" precision="0" unit="counts" color="ff5252">
            <input>cr</input>
        </value>
        <value label="Green" size="2" precision="0" unit="counts" color="66bb6a">
            <input>cg</input>
        </value>
        <value label="Blue" size="2" precision="0" unit="counts" color="42a5f5">
            <input>cb</input>
        </value>
        <separator height="0.3"/>
        <value label="밝기 (Clear)" size="2" precision="0" unit="counts" color="ffd740">
            <input>amb</input>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="센서 위에 색이 있는 물체나 조명을 비추어 보세요."/>
        <info label="값은 상대적 세기(counts)이며 조명 밝기에 따라 달라집니다."/>
    </view>
    </views>

    <export>
        <set name="색상 데이터">
            <data name="t (s)">t</data>
            <data name="R (counts)">cr</data>
            <data name="G (counts)">cg</data>
            <data name="B (counts)">cb</data>
            <data name="Clear (counts)">amb</data>
        </set>
    </export>
</phyphox>
