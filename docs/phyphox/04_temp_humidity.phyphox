<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>온도·습도</title>
    <icon format="string">T/H</icon>
    <color>42eaff</color>
    <category>Nano 33 BLE Sense</category>
    <description>HS3003 센서로 온도와 상대 습도를 측정합니다.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">temp</container>
        <container size="0">hum</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">00003041</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">temp</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">hum</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="온도" labelX="시간" unitX="s" labelY="온도" unitY="°C" partialUpdate="true" style="lines" lineWidth="2">
            <input axis="x">t</input>
            <input axis="y" color="ff8a65">temp</input>
        </graph>
        <graph label="상대 습도" labelX="시간" unitX="s" labelY="습도" unitY="%" partialUpdate="true" style="lines" lineWidth="2">
            <input axis="x">t</input>
            <input axis="y" color="81d4fa">hum</input>
        </graph>
    </view>
    <view label="측정값">
        <value label="온도" size="3" precision="2" unit="°C" color="ff8a65">
            <input>temp</input>
        </value>
        <value label="상대 습도" size="3" precision="1" unit="%" color="81d4fa">
            <input>hum</input>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="보드 자체 발열로 실제 기온보다 약간 높게 측정될 수 있습니다."/>
        <info label="입김을 불거나 손으로 감싸 온·습도 변화를 관찰해 보세요."/>
    </view>
    </views>

    <export>
        <set name="온습도 데이터">
            <data name="t (s)">t</data>
            <data name="온도 (°C)">temp</data>
            <data name="습도 (%)">hum</data>
        </set>
    </export>
</phyphox>
