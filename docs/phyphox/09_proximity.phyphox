<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>근접</title>
    <icon format="string">PRX</icon>
    <color>42eaff</color>
    <category>Nano 33 BLE Sense</category>
    <description>APDS9960으로 물체와의 상대 거리를 측정합니다. 0(가까움)~255(멀음).</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">prox</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">00005041</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">prox</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="근접값 (작을수록 가까움)" labelX="시간" unitX="s" labelY="근접" unitY="" partialUpdate="true" style="lines" lineWidth="2">
            <input axis="x">t</input>
            <input axis="y" color="ce93d8">prox</input>
        </graph>
    </view>
    <view label="측정값">
        <value label="근접값" size="3" precision="0" color="ce93d8">
            <input>prox</input>
        </value>
        <separator height="0.3"/>
        <value label="판정" size="2" precision="0" color="ce93d8">
            <input>prox</input>
            <map max="30">매우 가까움</map>
            <map min="30" max="100">가까움</map>
            <map min="100" max="200">중간</map>
            <map min="200">멀음</map>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="적외선 반사 방식이라 물체의 색/재질에 따라 값이 달라집니다."/>
        <info label="정밀 거리 측정이 아닌 상대적 근접도 지표입니다."/>
    </view>
    </views>

    <export>
        <set name="근접 데이터">
            <data name="t (s)">t</data>
            <data name="근접값 (0-255)">prox</data>
        </set>
    </export>
</phyphox>
