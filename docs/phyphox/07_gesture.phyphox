<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>제스처</title>
    <category>Nano 33 BLE Sense</category>
    <description>APDS9960 위에서 손을 움직이면 방향(왼쪽/오른쪽/위/아래)을 인식합니다.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">gest</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">00004041</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">gest</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="제스처">
        <info label="센서 위 3~10 cm에서 손을 한 방향으로 움직이세요." bold="true"/>
        <separator height="0.3"/>
        <value label="인식된 동작" size="3" precision="0" color="ffd740">
            <input>gest</input>
            <map max="0.5">대기 중</map>
            <map min="0.5" max="1.5">← 왼쪽</map>
            <map min="1.5" max="2.5">→ 오른쪽</map>
            <map min="2.5" max="3.5">↑ 아래에서 위로</map>
            <map min="3.5">↓ 위에서 아래로</map>
        </value>
        <separator height="0.3"/>
        <graph label="제스처 이력 (1=왼쪽 2=오른쪽 3=아래→위 4=위→아래)" labelX="시간" unitX="s" labelY="코드" unitY="" partialUpdate="true" style="dots" lineWidth="3">
            <input axis="x">t</input>
            <input axis="y" color="ffd740">gest</input>
        </graph>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="방향은 USB 커넥터를 아래로 두었을 때 기준입니다."/>
        <info label="인식이 안 되면 손을 조금 더 천천히, 가까이에서 움직여 보세요."/>
    </view>
    </views>

    <export>
        <set name="제스처 데이터">
            <data name="t (s)">t</data>
            <data name="제스처 코드">gest</data>
        </set>
    </export>
</phyphox>
