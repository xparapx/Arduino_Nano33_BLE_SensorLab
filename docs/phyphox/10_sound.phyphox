<phyphox xmlns="http://phyphox.org/xml" version="1.14">
    <title>음량</title>
    <icon format="string">SND</icon>
    <color>42eaff</color>
    <category>Nano 33 BLE Sense</category>
    <description>내장 마이크(MP34DT06)로 소리의 크기를 측정합니다. 0 dBFS가 최대이며 값은 음수입니다.</description>

    <data-containers>
        <container size="0">t</container>
        <container size="0">db</container>
        <container size="0">rms</container>
    </data-containers>

    <input>
        <bluetooth name="Nano" mode="notification" subscribeOnStart="true">
        <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">00006041</config>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">t</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">db</output>
        <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">rms</output>
        </bluetooth>
    </input>

    <analysis sleep="0" onUserInput="false"></analysis>

    <views>
    <view label="그래프">
        <graph label="음량 레벨" labelX="시간" unitX="s" labelY="레벨" unitY="dBFS" partialUpdate="true" style="lines" lineWidth="2">
            <input axis="x">t</input>
            <input axis="y" color="4dd0e1">db</input>
        </graph>
        <graph label="RMS 진폭" labelX="시간" unitX="s" labelY="RMS" unitY="" partialUpdate="true" style="lines" lineWidth="1.5">
            <input axis="x">t</input>
            <input axis="y" color="ffd740">rms</input>
        </graph>
    </view>
    <view label="측정값">
        <value label="음량" size="3" precision="1" unit="dBFS" color="4dd0e1">
            <input>db</input>
        </value>
    </view>
    <view label="안내">
        <info label="사용 방법" bold="true"/>
        <separator height="0.3"/>
        <info label="1. Nano 33 보드의 전원을 켭니다 (연결되면 LED가 초록색)."/>
        <info label="2. 재생(▶) 버튼을 누르면 자동으로 연결되어 측정이 시작됩니다."/>
        <info label="3. 일시정지 후 다시 시작하면 이어서 기록됩니다. 휴지통 아이콘으로 초기화."/>
        <info label="4. 데이터 저장: 우측 상단 메뉴 → '데이터 내보내기' (CSV / Excel)."/>
        <separator height="0.3"/>
        <info label="BLE 대역폭 한계로 파형이 아닌 '크기(레벨)'를 전송합니다."/>
        <info label="상대값(dBFS)이므로 절대 dB(SPL)와는 다릅니다. 큰 소리일수록 0에 가까워집니다."/>
    </view>
    </views>

    <export>
        <set name="음량 데이터">
            <data name="t (s)">t</data>
            <data name="레벨 (dBFS)">db</data>
            <data name="RMS">rms</data>
        </set>
    </export>
</phyphox>
